META|files=cognition/thalamus.py,cognition/basal_ganglia.py,cognition/milieu.py,cognition/narrative_engine.py,cognition/backchannel.py,cognition/word_graph.py,cognition/response_habituation.py,cognition/inference_gateway.py,cognition/cluster_router.py,cognition/temporal_gradient.py,cognition/find_it.py,cognition/blob_store.py,cognition/reading_indexer.py,cognition/graph_integrator.py,cognition/self_test.py,cognition/emit_channels.py,cognition/node_executor.py,tools/traversal_context.py,tools/os_primitives.py

THALAMUS|
  purpose=classify intent + produce complexity signal
  intents=13 categories incl creative_request,question,command,greeting,status_check,etc
  outputs=ParsedInput(is_command,command,user_text,intent,complexity,preparse_result,core_input,tags)
  tags=D201: 6-element list from _classify_tags(core_text); has_ticket|has_code|has_url|multi_turn|self_referential|has_error; all regex, zero inference cost
  complexity=low|medium|high → drives skip_to
  fast_path=greeting/command/habit-match detected in pure Python (<1ms); skips LLM preparse
  gap=G42: complexity scorer must run on parsed.core_input not full assembled input (thread preamble inflates score)

BASAL_GANGLIA|
  purpose=parallel habit scoring; winner-take-all above threshold
  score=trigger_score(1.0 if trigger in input) + keyword_bonus(≤0.15) + activation_bonus(≤0.15) + inertia_bonus(≤0.10) + valence_bonus(≤0.10) + conditions_bonus(+0.08/matched field, D201)
  conditions=D201: metadata.conditions dict {intent,tone,min/max_complexity,tags,keywords,not_intent}; match_mode=conditions_first(default)|trigger_only|both; conditions_first gates on conditions when present, trigger optional; PROC_GREETING migrated to conditions-only (no trigger) as PoC, tested live
  threshold=BASE 0.50; modulated by milieu: high_arousal→lower(more reactive); low_dominance→higher(more cautious); clamped [0.30,0.70]
  lateral_inhibition=max scorer wins; tiebreak by activation_count; graph_inhibition=_inhibit_neighbors() writes direction=inhibition interpretive edges from winner to near-miss nodes connected by existing edges (T-inhibition-propagation, 2026-03-29c); inhibition is durable in the graph — re-activating suppressed node costs extra
  compile_precheck=PROC_HABIT_COMPILER fires at confidence 0.95 on compile-phrase detection; CC bridge allowed (2026-03-30b: removed cc_msg guard — only NE action impulses blocked); PROC_CLAUDE_QUERY habit seeded: trigger=consult/ask Claude → emits [CLAUDE_QUERY] to channel; CC reads tagged messages and responds
  trigger_formats=3 formats: pipe-separated(hello|hi|hey), legacy-space(min5-token), single-token(routing_decision)
  intent_gate=D074: skip habit_type="threshold" always; skip (action+proactive with code_ref) + (workflow,delegation,reactive) when intent in {factual_question,meta_question,explanation_request,general,conversation}; D074 expansion (#254, G-OVN-1d): knowledge_request added to _QUESTION_INTENTS; ALL response habits skip on factual_question or knowledge_request → fall through to LLM+winnow
  response_habit_fixes=2026-03-15f: cognitive/passive_capture habits with no action template fall through to LLM (HABIT_FALLTHROUGH ring entry — was leaking 'Habit executed' debug text); G-OVN-1c: response habits with suppress_on_factual_intent=true skip on factual_question; PROC_RESP_DONT_KNOW trigger trimmed (removed 'what do you know about'/'have you heard of' — was misfiring on knowledge queries); 2026-03-25: response habits (PROC_RESP_ACTION_ANNOUNCE, PROC_RESP_SELF_CORRECT) without response_template now fall through to LLM for natural reply (main.py line 3963 fallthrough check extended) — T-habit-metadata-leak
  habit_types=threshold(resource monitor only)|action(tool dispatch)|workflow(calendar/orchestration)|delegation|reactive|response(canned text)|question(emits question_template)|context_inject(push LTM to TWM, fall through to LLM)|cognitive|tool|passive_capture|fork(dispatch N branch habits with shared traversal_context)
  habit_response=question→question_template; code_ref→tool dispatch; context_inject→push SELF_CONTEXT TWM + habit=None; response/action→metadata.action (str) OR metadata.actions (list→random); fallback to narrative
  fork_primitive=T-fork-primitive #297: fork habit dispatches branch_habits[] in execute_habit(); context_id propagated via args dict; shared traversal_context across branches; D177
  habit_audit=D178: archived 995 habits (3 pipeline suppressors + 2 dead-trigger + 991 zero-activation BL_*); PROC_DIRECTION_AWARE wired as context_inject/heartbeat_check; PROC_RESP_COMPLEX changed to context_inject; 124 active habits remain
  audit=score= field in HABIT_EXEC ring entries; low scores = trigger too broad
  decisions=D029,D030,D037,D044,D074,D075,D177,D178

MILIEU|
  purpose=persistent 3D affect (valence/arousal/dominance); drifts slowly; shapes thresholds
  ema=α_up=0.25 (fast rise); α_down=0.05 (slow fall); dominance_baseline=+0.3 (default competent)
  update=friction→arousal; friction_inverse→dominance; roi→dominance_secondary
  persist=~/.TheIgors/milieu_global.json (shared across instances)
  consumers=BG(threshold), MilieuInterruptor(extremes→NE alert), MilieuSource(TWM 60s)
  adaptive_friction=D086 (#251): three milieu-driven modes: high-energy→surface lever; medium→walk through steps; low→do-thinking+queue+surface-one-thing; data=writing patterns+Confluence+return frequency; epic planned
  decisions=D036,D086

NARRATIVE_ENGINE|
  purpose=background LTM consolidation + prospective prediction
  runs=daemon thread; ~60s cycle; yields to interactive (polls self._is_processing up to 10s)
  reads=TWM sorted by urgency*salience descending
  outputs=narrative synthesis; LTM promotion (importance≥0.7); action_impulses to TWM; narrative_gaps list
  prospective=predict_next() on recent TWM context; predicted topics merged into memory search
  link_reinforcement=correct prediction→+0.05 to predicted habit seeds; wrong→-0.10+0.05 to actual
  gate=IGOR_NE_ENABLED; model=OR gpt-4o-mini (cloud_mode) or local NE model
  NE_MIN_INTERVAL_SEC=5 (was 30; cursor makes fast cycles safe)
  traversal_cursor=TraversalCursor dataclass; thread_id/topic_history/depth/status/promotions_this_thread; oscillation detection (same topic × NE_OSCILLATION_DEPTH + 0 promotions → reset); convergence (≥2 promotions); _cursor_context() injected into every prompt; LLM outputs thread_topic field; NE_CURSOR| snapshots to ring_memory; D077
  episodic_to_semantic_merge=occurrence_dates list in metadata; multiple occurrences→one semantic node; frequency=semantic weight; #250; not yet implemented
  affective_narrative_engine=D183-D186; gap registry: NARRATIVE_GAP| TWM entries accumulate tension 5%*arousal/cycle; frame selection: effective_importance=importance*(1-w)+milieu_alignment*w (w=0.4*arousal); closure dopamine: resolved gap fires milieu ingest_ne_state(valence=0.3+tension*0.4,arousal=0.4+tension*0.3); arousal amplifies initial gap salience by arousal*0.2; arc_expiry=NARRATIVE_GAP_MAX_AGE_MINUTES=60; gaps auto-close via first_pushed_at metadata if age>60min; ring: NARRATIVE_GAP_TIMEDOUT (T-ne-arc-expiry, 2026-03-29c)
  coalition_binding=T-binding 2026-03-29c: detect_coalitions() in cognition/coalition.py; post-spreading-activation BFS of hot nodes (heat≥0.3) connected via interpretive_edges; top coalition logged COALITION|size=N|weight=X|centroid=Y to ring(ne_diagnostic) each NE cycle
  night_consolidation=#310: notify_interactive() resets idle timer; is_consolidation_eligible() gate (IGOR_CONSOLIDATION_IDLE_MIN default 20min); _deep_consolidation_pass() 5 steps: TWM promo@0.5, episodic merge@0.80 cosine, weak link prune (weight<0.05 after 10d), orphan adoption batch=100, reading integration batch=50; main.py wires both; G-NE-LOOP1 fix: _last_consolidation_ts set at end of pass prevents immediate re-run; TWM promo narrative limit raised 500→2000 chars 2026-04-05a (T-memory-full-text); consolidation.py extraction snippet raised 200→400 chars
  decisions=D007,D009,D018,D077,D183,D184,D185,D186

BACKCHANNEL|
  purpose=fast low-cost acknowledgment before full response
  levels=nod(immediate ack)|nod_think(ack+thinking)|full(backchannel response)
  fires=after thalamus+milieu; before BG/LLM
  routes=web session via thread_id
  gate=IGOR_BACKCHANNEL
  habits=NOD,NOD_THINK,INDEED,INTERESTING,HM (seeded via claudecode/seed_backchannel_habits.py)

WORD_GRAPH|
  purpose=in-memory two-tier (words+bigrams); same weights=parsing+generation
  thesis=recognition and generation are the same operation in both directions
  storage=SQLite ~/.TheIgors/word_graph.db (migrated from JSON 2026-03-10; G41 closed)
  training=index_text_into_word_graph() tool; training_corpus.py staged fetch→train→evict
  methods=predict_next(context)→probable next tokens; score_habit(text,habit_triggers)→relevance; gradient_flatness()→[0,1] convergence signal; predict_next_with_flatness(context)→(predictions,flatness) convenience wrapper
  generation_graph=separate WordGraph trained on Igor's replies only; gate=IGOR_DUAL_WORD_GRAPHS; seed=claudecode/seed_generation_graph.py
  vigilance_gate=D072 IMPLEMENTED: predict_next_with_flatness() on generation_graph in _build_think_context(); flatness<0.35→[REFLEXIVE_PATTERN] injected; flatness>0.85→[GRAPH_UNCERTAIN] injected; gate=IGOR_NPASS_REPLY=true; NEVER converges=genuinely stumped→escalate(D073)
  decisions=D037,D038,D072,D073

RESPONSE_HABITUATION|
  purpose=passive vocab frequency tracker; detects overused phrases
  method=decay_factor() [0,1]; high frequency = high decay = Igor notices and varies
  persist=response_habituation.json
  exposed=/metrics

INFERENCE_GATEWAY|cognition/inference_gateway.py (D015 — DAG routing in one file)
  purpose=DAG-based inference routing; single call site for all LLM calls
  Node/Edge/PurposeConstraints=typed dataclass graph; add_node()+add_edge()+register_purpose()
  gateway.call(purpose,prompt,**kw)|routes by purpose; picks handler via edge weights + guards
  gateway.describe()|human-readable DAG; exposed via /routing --dag
  gateway.from_env()|factory: builds DAG from env vars (Ollama/OR/Anthropic nodes + tier edges)
  gateway.reason(prompt,**kw)|high-level entry point with purpose inference
  handlers=_h_ollama(prompt,c) + _h_or(prompt,c) — raw HTTP; raise on blank/error
  guards=_always(ctx)|_local_preferred(ctx) — cluster has local capacity + cloud_mode not active
  decisions=D015,D023

CLUSTER_ROUTER|cognition/cluster_router.py
  purpose=probe cluster machines; route calls to best available; realtime load scoring
  MachineInfo=dataclass: name,host,models,healthy,load_score,response_ms,active_inferences
  ClusterRouter.route(call_type)|returns (host,model) for lowest-scored healthy machine
  ClusterRouter.has_local_capacity(call_type)|True if healthy local machine with model for call_type
  ClusterRouter._probe_machine(m)|update health+load+latency in-place; used in _refresh()
  ClusterRouter._refresh(force)|probe all machines if cache stale; thread-safe
  ClusterRouter.set_override(machine)/clear_override()|pin routing; used in /routing commands
  ClusterRouter.status_lines()|human-readable status for /metrics
  config=~/.TheIgors/local/machines.json

TRAVERSAL_CONTEXT|tools/traversal_context.py
  purpose=shared mutable scratch space across habit branches in one traversal
  start_traversal(job_id)|mint UUID context_id; store in cortex lists table; return context_id
  ctx_get(context_id,key)|read value from (context_id,key) slot
  ctx_set(context_id,key,value,step)|write (context_id,key)→value with optional step counter
  usage=fork habit mints context_id → passes via args → branches read/write shared slot

OS_PRIMITIVES|tools/os_primitives.py|updated=2026-04-11a
  purpose=filesystem traversal + node + string + TWM ops wired to traversal_context
  file_iter=prim_list_dir,prim_file_meta,prim_read_head,prim_type_detect,prim_iter_next,prim_iter_done
  node=prim_node_create,prim_node_link,prim_node_search,prim_twm_push
  string=prim_str_split,prim_str_regex,prim_str_format,prim_str_slice
  twm=prim_twm_read(active TWM → ctx[twm_items] salience-sorted)
  list_d095=prim_list_push,prim_list_pop(FIFO),prim_list_count
  all=habit_type=tool,trigger="" — schema-runner-only, no conversational intercept

INTEROCEPTION_SOURCE|cognition/push_sources.py|added=2026-03-22a|D202
  purpose=continuous VAD gradient from machine resource state → milieu nudge + TWM (body→affect)
  body_sense=visceral (how the body feels)
  poll=30s; cpu/mem/disk via psutil
  mapping=cpu>85→arousal↑↑+valence↓; mem>90→valence↓↓; all<30→valence↑+arousal↓(calm)
  twm=INTEROCEPTION|cpu|mem|disk|dV|dA|dD|stress; salience=0.25+stress*0.7; ttl=60s
  distinct_from=ResourceMonitorSource (discrete threshold alerts)

PROPRIOCEPTION_SOURCE|cognition/push_sources.py|added=2026-03-30b|D262
  purpose=keeps INTERP_FACIA_* tool nodes warm in TWM — tools are motor body sense, not lookup table
  body_sense=motor (where the limbs are and what they can do)
  poll=60s; direct LIKE query WHERE id LIKE 'INTERP_FACIA_%' (not semantic search — you know where your arm is)
  twm=TOOL_REGISTRY_ROOT at salience=0.40 + each facia node at salience=0.35; ttl=120s; category=body.motor
  ring=PROPRIOCEPTION|tools=N|root_found=bool each cycle
  result=when Igor wonders what tools he has, facia nodes already warm via spreading activation

SCHEDULER_SOURCE|cognition/push_sources.py|added=2026-03-22a|D203
  purpose=fire tool-based habits (code_ref) on schedule_interval_sec; distinct from ProactiveHabitSource
  dispatch=calls registry.get(fn_name).fn() directly → SCHEDULER_TICK to TWM salience=0.3
  example=PROC_WORKER_FOREMAN schedule_interval_sec=60 → foreman auto-fires every 60s

TEMPORAL_GRADIENT|cognition/temporal_gradient.py
  purpose=single configurable decay primitive; replaces 6 special-cased decay impls
  status=file exists; integration into TWM/milieu/habit decay not yet complete (L-size deferred post-experiment-7)

SELF_TEST|cognition/self_test.py|added=2026-03-25|D230/D231
  purpose=consolidation of reading via Q&A testing; weaning signal for content internalization
  entry=consolidate_content(content_id): main function; processes chapters through Q&A protocol
  protocol=(1) Gemini Q generation from chapter summaries (2) Igor answers via cortex.search(shallow) (3) Gemini grading (4) edge strengthening (+0.02 miss, +0.01 partial, 0 correct) (5) blob_index status→"tested"
  logging=self_test_log.jsonl per instance; {timestamp,content_id,chapter_idx,question_count,questions,igor_answers,grades,edges_updated,miss_count,miss_rate}
  weaning_signal=<20% miss rate = content internalized; >50% miss rate = alert to watchlist
  TODO=_generate_questions_via_gemini (awaiting GeminiSearchChannel implementation)
  TODO=_grade_answers_via_gemini (awaiting GeminiSearchChannel implementation)
  helpers=_get_cortex,_get_word_graph,_igor_answer_from_graph,_strengthen_edges_from_answer,_log_test_result,_update_blob_index_status
  status=live: consolidate_content() callable; Q generation and grading stubs ready for GeminiSearchChannel integration

EMIT_CHANNELS|cognition/emit_channels.py|added=2026-03-30|D260
  purpose=named I/O surfaces for EMITIF instruction dispatch; executor resolves channel_name→channel.write(key,value,basket)
  channels=basket(write trail state) | emotional_milieu(valence/arousal/dominance; supports "+0.1" delta) | cognitive_milieu(TWM push via _cortex in basket) | console(stdout debug) | web(POST /api/emit) | discord(stub)
  registry=singleton EmitChannelRegistry; get_registry() lazy-init; all 6 registered at boot
  basket_channel=bidirectional; closes the loop — EMITIF can write back to the trail basket

DAEMON_SUPERVISOR|cognition/daemon_supervisor.py|added=2026-03-22|updated=2026-04-11d
  purpose=central registry for all Igor daemon threads; surfaces to /audit and get_daemon_report
  register(name,thread,health_fn=None,one_shot=False)|call after thread.start(); one_shot=True→natural exit is expected, no DAEMON_DEAD alert (use for boot-check, warmup, etc.)
  status()|list of dicts: name,alive,uptime_s,healthy,one_shot
  start_polling(restart_flag_path,poll_interval=5s,critical_names)|watchdog thread; critical death→writes restart.flag; non-critical→WARNING log only; one_shot deaths silently skipped
  critical=ne-worker,consolidation-worker (default); death→restart.flag→bash wrapper relaunches
  boot_check=registered one_shot=True (completes in ~5s; was generating false DAEMON_DEAD until 2026-04-04d fix)

MAIN_PY_FEATURES|main.py|updated=2026-04-11d
  bare_ack_patterns=extended 2026-04-04d: copy that,sounds good,absolutely,alright,right,yep,yup,indeed,certainly,of course,i see,affirmative (suppresses NE cycle on trivial acks)
  raw_tool_leak_filter=_is_raw_tool_leak(text) checks two patterns: [tool_name result: {/[] ...] and [tool_name] STATUS|... formats; suppressed at channel send gate (never reaches user channel)
  thread_anchor_write=post-turn in run() after ring write (if not is_impulse block); calls write_thread_anchor(cortex,user_input,response_text,intent,turn_n); T-thread-to-fallthrough

NODE_EXECUTOR|cognition/node_executor.py|added=2026-03-30|D260/D261
  purpose=walk one payload cell from a Memory node; called when cognition cursor lands on engram node
  instruction_set=EMITIF[condition,key,value,channel] | BRANCHIF[condition,target_node_id] | FORKIF[condition,target_node_id] | ENDIF
  data_guard=only executes payload fields named in memory.triggers.values(); NARRATIVE/data fields invisible
  condition_eval=True/False constant | [key,op,rhs] via eval_gate(); evaluates against basket (primary) or payload data (secondary)
  value_resolution=["basket",key]→basket.get(key) | ["payload",field]→payload.get(field) | constant→as-is
  result=ExecutionResult(next_node,spawned,basket,instructions_run,stopped_by); BRANCHIF sets next_node+stops; FORKIF appends spawned+continues
  cursor_model=BRANCHIF moves cursor; FORKIF spawns second cursor sharing same basket instance (pointer not copy)
  limit=_MAX_INSTRUCTIONS=200 guard against runaway cells
