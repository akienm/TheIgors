#!/usr/bin/env bash
# pre-commit hook: guard CLAUDE.md rule violations, then sync skills.
# Install: ln -sf ../../lab/claudecode/hooks/pre-commit .git/hooks/pre-commit
# (run from repo root, or let install_igor_linux.sh do it)
#
# Rules enforced (per CLAUDE.md destructive-action blocklist):
#   - staged .env / .env.* rejected
#   - staged *.db rejected (SQLite leaks; Igor uses Postgres)
#   - staged paths under ~/.TheIgors/ rejected (runtime state, not code)
#
# --amend detection lives in the sibling prepare-commit-msg hook.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

reject() {
    # $1 = path, $2 = reason
    printf '\033[31mpre-commit: REJECTED\033[0m %s\n  → %s\n' "$1" "$2" >&2
}

bad=0
while IFS= read -r path; do
    [ -z "$path" ] && continue
    base="$(basename "$path")"

    # Rule 1: .env files
    if [ "$base" = ".env" ] || [[ "$base" == .env.* ]]; then
        reject "$path" ".env files must not be committed (secrets). CLAUDE.md blocklist."
        bad=1
        continue
    fi

    # Rule 2: *.db (SQLite leaks — Igor is Postgres-only)
    if [[ "$base" == *.db ]]; then
        reject "$path" "*.db staged — Igor uses Postgres, not SQLite. Check what leaked this."
        bad=1
        continue
    fi

    # Rule 3: runtime paths under ~/.TheIgors/ (unlikely but guard anyway)
    if [[ "$path" == .TheIgors/* ]] || [[ "$path" == *.TheIgors/* ]]; then
        reject "$path" "~/.TheIgors/ is runtime state — not code. Do not commit."
        bad=1
        continue
    fi

done <<< "$STAGED"

if [ "$bad" -eq 1 ]; then
    printf '\n\033[31mpre-commit aborted.\033[0m Unstage the offending files, then retry.\n' >&2
    exit 1
fi

# ── Skills sync — RETIRED 2026-05-02 (T-skills-content-migrate-to-master) ──
# Skills now live in UnseenUniversity (canonical). Edit them there, then run
# `agentctl skills deploy` to push to ~/.claude/skills/ on this box.
# map-igor and readigor remain TheIgors-internal under lab/claudecode/cc_skills/
# (they read Igor-specific runtime state and are not agent skills).

exit 0
