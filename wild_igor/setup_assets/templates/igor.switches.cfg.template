# igor.switches.cfg — feature gates and tuning knobs (D319).
# Location: ~/.TheIgors/${IGOR_INSTANCE_ID}/igor.switches.cfg
# Template is in the repo; actual file is gitignored (allows local overrides
# without forcing a repo push for every tweak).

# ── Self-edit / autonomy gates ────────────────────────────────────────────────
# Allow Igor to write to his own source files.
IGOR_SELF_EDIT_ENABLED=false

# Allow Anthropic direct spend (tier 5). Keep false until 4090 arrives.
IGOR_TIER5_ENABLED=false

# Human-approval queue for HIGH-inertia edits.
IGOR_ARBITER_ENABLED=false

# ── Pipeline feature flags ────────────────────────────────────────────────────
IGOR_CLOUD_TRAINING_ENABLED=true
IGOR_TWO_PHASE_CALLS=true
IGOR_NPASS_REPLY=true
IGOR_CONTEXT_WINNOW=true
IGOR_READING_EXTRACT=true
IGOR_HABIT_EXTRACT=true

# ── Cost / safety limits ──────────────────────────────────────────────────────
# Max agentic tool turns per call.
IGOR_MAX_TURNS=8

# Per-call cost cap in USD; calls exceeding this are blocked.
IGOR_CALL_COST_WARN_USD=2.00

# ── Research mode ─────────────────────────────────────────────────────────────
IGOR_RESEARCH_MODE=false
