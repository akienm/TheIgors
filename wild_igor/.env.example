# Igor - Wild Instance
# Copy to .env and fill in your values. Never commit .env.

# ── Reasoning ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Model selection ────────────────────────────────────────
# Aliases: sonnet, opus, haiku (or full model ID)
# Default: claude-sonnet-4-6
# Switch at runtime with /model command
IGOR_MODEL=claude-sonnet-4-6

# ── Local Ollama pre-parser ─────────────────────────────────
# Set to false to skip local LLM pre-processing (faster startup, lower CPU)
# Toggle at runtime with /ollama command
IGOR_OLLAMA=true

# ── Timezone (for get_datetime tool) ───────────────────────
# IANA timezone name, e.g. America/New_York, America/Denver, US/Pacific
# Leave blank to use system local time
TZ=

# ── Instance ───────────────────────────────────────────────
IGOR_INSTANCE_ID=wild-0001

# ── Gmail ──────────────────────────────────────────────────
# Use a Gmail App Password (not your main password)
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=igor-0001@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Discord ────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: restrict to specific channel. Leave blank for all channels.
DISCORD_CHANNEL_ID=

# ── Web UI ─────────────────────────────────────────────────
# Local-network chat UI served by Igor. Access at http://localhost:IGOR_WEB_PORT
# Build the Svelte frontend first: cd wild_igor/web_ui && npm install && npm run build
IGOR_WEB_PORT=8080
