#!/usr/bin/env bash
# igor — launcher script for Wild Igor
# Lives at repo root: TheIgors/igor
# Symlink: ~/bin/igor -> /home/akien/TheIgors/igor
#
# Usage:
#   igor                  # start (runs first-start wizard if no .env found)
#   igor --id wild-0002   # start with a specific instance ID
#   igor --help           # show help

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
WILD_DIR="$REPO_DIR/wild_igor"
VENV_DIR="$REPO_DIR/venv"
VENV_PYTHON="$VENV_DIR/bin/python"

# Sanity checks
if [ ! -d "$WILD_DIR" ]; then
    echo "[igor] ERROR: wild_igor directory not found at $WILD_DIR" >&2
    exit 1
fi

if [ ! -f "$VENV_PYTHON" ]; then
    echo "[igor] ERROR: venv python not found at $VENV_PYTHON" >&2
    echo "[igor] Run: python3 -m venv $VENV_DIR && pip install -r $WILD_DIR/requirements.txt" >&2
    exit 1
fi

# Locate .env — check IGOR_INSTANCE_ID or default instance dir
RUNTIME_ROOT="${IGOR_RUNTIME_ROOT:-$HOME/.TheIgors}"
INSTANCE_ID="${IGOR_INSTANCE_ID:-igor_wild_0001}"
ENV_FILE="$RUNTIME_ROOT/$INSTANCE_ID/.env"

if [ ! -f "$ENV_FILE" ]; then
    # Try to find any existing instance .env
    FOUND=$(find "$RUNTIME_ROOT" -maxdepth 2 -name ".env" 2>/dev/null | head -1)
    if [ -n "$FOUND" ]; then
        ENV_FILE="$FOUND"
        echo "[igor] Using existing instance: $ENV_FILE"
    else
        # First-start: run the wizard
        echo "[igor] No instance found — running first-start wizard..."
        # Activate venv first so wizard can import igor.paths
        source "$VENV_DIR/bin/activate"
        WIZARD_OUT=$("$VENV_PYTHON" -m igor.first_start 2>&1)
        WIZARD_EXIT=$?
        if [ $WIZARD_EXIT -ne 0 ]; then
            echo "$WIZARD_OUT" >&2
            exit 1
        fi
        # Extract the env file path from wizard output
        ENV_FILE=$(echo "$WIZARD_OUT" | grep '^IGOR_ENV_FILE=' | cut -d= -f2-)
        # Print wizard output (minus the machine-readable line)
        echo "$WIZARD_OUT" | grep -v '^IGOR_ENV_FILE='
        if [ -z "$ENV_FILE" ] || [ ! -f "$ENV_FILE" ]; then
            echo "[igor] ERROR: wizard did not produce a valid .env" >&2
            exit 1
        fi
        echo "[igor] Instance created. Edit $ENV_FILE to add API keys, then re-run igor."
        exit 0
    fi
fi

# Activate venv
source "$VENV_DIR/bin/activate"

# Change to wild_igor dir so relative paths work
cd "$WILD_DIR"

# Default instance ID if --id not specified
IGOR_ARGS=("$@")
if [[ ! " $* " =~ " --id " ]]; then
    IGOR_ARGS=("--id" "wild-0001" "$@")
fi

# Restart loop: exit code 42 means "please restart"
# .env is re-read on every restart so env changes take effect immediately.
while true; do
    set -a; source "$ENV_FILE"; set +a
    if [ -e "$REPO_DIR/pause.wait" ]; then
        echo "Waiting for $REPO_DIR/pause.wait to clear."
        while [ -e "$REPO_DIR/pause.wait" ]; do
            sleep 1
        done
    fi
    python -m igor.main "${IGOR_ARGS[@]}"
    EXIT_CODE=$?
    if [ $EXIT_CODE -eq 42 ]; then
        echo "[igor] Restarting (re-reading .env)..."
    else
        break
    fi
done
