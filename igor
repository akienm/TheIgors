#!/usr/bin/env bash
# igor — minimal launcher (D321).
# Lives at repo root: TheIgors/igor
# Symlink: ~/bin/igor -> /home/akien/TheIgors/igor
#
# Usage:
#   igor                  # start Igor (setup + migrate + run)
#   igor --id wild-0002   # start with a specific instance ID
#   igor --help           # show help
#
# This script's only job: find Python + ensure venv exists, then hand off
# to UnseenUniversity/devices/igor/setup_assets/installer.py (platform-smart Python).
# All restart logic and crash recovery live in installer.py.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
UU_DIR="$HOME/dev/src/UnseenUniversity"
VENV_DIR="$UU_DIR/.venv"
INSTALLER="$UU_DIR/devices/igor/setup_assets/installer.py"

if [ ! -d "$VENV_DIR" ]; then
    echo "[igor] UU venv not found — run: cd $UU_DIR && pip install -e ."
    exit 1
fi

# D335: start utility closet if not already running
UC_SERVER="$UU_DIR/lab/claudecode/utility_closet_server.py"
IGOR_HOME="${HOME}/.unseen_university"
if [ -f "$UC_SERVER" ]; then
    if "$VENV_DIR/bin/python" "$UC_SERVER" --check >/dev/null 2>&1; then
        echo "[igor] Utility closet: running"
    else
        echo "[igor] Utility closet: starting..."
        mkdir -p "$IGOR_HOME/logs"
        setsid "$VENV_DIR/bin/python" "$UC_SERVER" >>"$IGOR_HOME/logs/utility_closet.log" 2>&1 &
        for _i in 1 2 3 4 5; do
            sleep 1
            if "$VENV_DIR/bin/python" "$UC_SERVER" --check >/dev/null 2>&1; then
                echo "[igor] Utility closet: started"
                break
            fi
        done
    fi
fi

# Launch inside tmux so Igor's restart loop and tools stay attached.
IGOR_TMUX_SESSION="${IGOR_TMUX_SESSION:-igor}"
export IGOR_TMUX_SESSION

if [[ -n "${TMUX:-}" ]]; then
    exec "$VENV_DIR/bin/python" "$INSTALLER" "$@"
else
    tmux new-session -d -s "$IGOR_TMUX_SESSION" 2>/dev/null || true

    # Console logging handled by DailyConsoleFileHandler in logging_setup.py —
    # writes YYYYMMDD.console.log with ANSI color codes, no pipe-pane needed.

    IGOR_CMD="cd $(printf '%q' "$PWD") && $(printf '%q' "$0")"
    for arg in "$@"; do
        IGOR_CMD+=" $(printf '%q' "$arg")"
    done
    tmux send-keys -t "$IGOR_TMUX_SESSION" "$IGOR_CMD" Enter
    exec tmux attach -t "$IGOR_TMUX_SESSION"
fi
